# Dev only. Reasoning (why slim not alpine, rebuild-on-new-dep rule): docs/ARCHITECTURE.md
FROM node:22-slim
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm install
COPY . .
EXPOSE 3000
# --webpack, not Turbopack's default: WATCHPACK_POLLING only works with webpack's watcher, see LEARNING.md
CMD ["npm", "run", "dev", "--", "--webpack", "-H", "0.0.0.0", "-p", "3000"]
