// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

// musl target required for node:22-alpine dev image, see docs/ARCHITECTURE.md#docker
generator client {
  provider      = "prisma-client"
  output        = "../app/generated/prisma"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

// All tables use UUID ids and are scoped by userId, see docs/ARCHITECTURE.md

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  imports       Import[]
  orders        Order[]
  payments      Payment[]
  discrepancies Discrepancy[]
}

enum FileKind {
  ORDERS
  PAYMENTS
}

// PENDING until parse/route.ts finishes; PARTIALLY_COMPLETED if some rows failed validation
enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  PARTIALLY_COMPLETED
  FAILED
}

model Import {
  id        String       @id @default(uuid())
  userId    String
  kind      FileKind
  key       String
  status    ImportStatus @default(PENDING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

// Columns match orders.csv exactly; order_id normalized per docs/RECONCILIATION-RULES.md (trim + uppercase)
model Order {
  id            String   @id @default(uuid())
  userId        String
  orderKey      String
  orderDate     DateTime
  customerEmail String?
  currency      String
  grossAmount   Decimal  @db.Decimal(10, 2)
  discount      Decimal? @db.Decimal(10, 2)
  netAmount     Decimal  @db.Decimal(10, 2)
  status        String
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, orderKey])
  @@index([userId])
}

// Columns match payments.csv exactly; order_reference normalized the same way as Order.orderKey
model Payment {
  id             String   @id @default(uuid())
  userId         String
  transactionRef String
  processedAt    DateTime
  orderKey       String
  currency       String
  amount         Decimal  @db.Decimal(10, 2)
  fee            Decimal  @db.Decimal(10, 2)
  netSettled     Decimal  @db.Decimal(10, 2)
  type           String
  status         String
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, orderKey])
}

// Class values match the classification table in docs/RECONCILIATION-RULES.md exactly
enum DiscrepancyClass {
  DUPLICATE_PAYMENT
  PAID_BUT_CANCELLED
  MISSING_PAYMENT
  FAILED_PAYMENT
  ORPHAN_PAYMENT
  CURRENCY_MISMATCH
  PARTIAL_REFUND
  UNRECORDED_REFUND
  OVERCHARGED
  UNDERCHARGED
  PENDING_PAYMENT
  DELAYED_SETTLEMENT
  MISSING_FIELDS
  WITHIN_TOLERANCE
  MATCHED
}

enum Severity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  NONE
}

model Discrepancy {
  id               String           @id @default(uuid())
  userId           String
  orderKey         String
  class            DiscrepancyClass
  severity         Severity
  amountDifference Decimal?         @db.Decimal(10, 2)
  details          Json?
  explanation      String?
  createdAt        DateTime         @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([userId, class])
}
