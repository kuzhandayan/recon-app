# Neon Postgres connection string
DATABASE_URL=

# Any long random string, e.g. `openssl rand -base64 32`
JWT_SECRET=

# console.groq.com — primary LLM for discrepancy explanations
GROQ_API_KEY=

# aistudio.google.com — automatic fallback, only called if Groq errors (optional)
GEMINI_API_KEY=

# Backblaze B2 (S3-compatible) — optional raw-CSV backup, not required by app logic
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
B2_ENDPOINT=
